"""Types for the native CatBoost API used by toolkit adapters."""

from collections.abc import Sequence
from pathlib import Path
from typing import Any, Self

import numpy as np
import pandas as pd
from numpy.typing import NDArray

class Pool:
    def __init__(
        self,
        data: object,
        label: object = ...,
        cat_features: object = ...,
        feature_names: object = ...,
        timestamp: object = ...,
        weight: object = ...,
        baseline: object = ...,
        **kwargs: Any,
    ) -> None: ...

class CatBoost:
    feature_names_: list[str]
    tree_count_: int
    def __init__(self, **params: Any) -> None: ...
    def fit(
        self, X: object, y: object = ..., eval_set: object = ..., **kwargs: Any
    ) -> Self: ...
    def predict(
        self, data: object, prediction_type: str | None = ..., **kwargs: Any
    ) -> NDArray[np.float64]: ...
    def get_best_iteration(self) -> int | None: ...
    def get_cat_feature_indices(self) -> list[int]: ...
    def get_feature_importance(
        self, data: Pool | None = ..., type: str = ..., **kwargs: Any
    ) -> NDArray[np.float64]: ...
    def get_tree_leaf_counts(self) -> NDArray[np.int64]: ...
    def get_leaf_values(self) -> NDArray[np.float64]: ...
    def get_scale_and_bias(self) -> tuple[float, float]: ...
    def set_scale_and_bias(self, scale: float, bias: float) -> None: ...
    def get_all_params(self) -> dict[str, object]: ...
    def get_params(self) -> dict[str, object]: ...
    def save_model(self, fname: str, **kwargs: Any) -> None: ...
    def load_model(self, fname: str | Path, **kwargs: Any) -> Self: ...
    def shrink(self, ntree_end: int, ntree_start: int = ...) -> None: ...
    def copy(self) -> Self: ...
    def eval_metrics(
        self, data: Pool, metrics: Sequence[str], **kwargs: Any
    ) -> dict[str, list[float]]: ...
    def get_evals_result(self) -> dict[str, dict[str, list[float]]]: ...

class CatBoostRegressor(CatBoost): ...

class CatBoostClassifier(CatBoost):
    def predict_proba(self, data: object, **kwargs: Any) -> NDArray[np.float64]: ...
