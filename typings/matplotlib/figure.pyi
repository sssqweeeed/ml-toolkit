from typing import Any

class Figure:
    def set_size_inches(self, width: float, height: float) -> None: ...
    def tight_layout(self, **kwargs: Any) -> None: ...
    def autofmt_xdate(self, **kwargs: Any) -> None: ...
    def suptitle(self, title: str, **kwargs: Any) -> object: ...
    def savefig(self, path: object, **kwargs: Any) -> None: ...
